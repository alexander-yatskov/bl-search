{
  "manifest_version": 3,
  "name": "BL Search",
  "version": "0.4.6",
  "description": "Hides blocked LinkedIn companies, groups duplicate jobs, and optionally syncs an encrypted blocklist.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://c418o3x5o5.execute-api.eu-central-1.amazonaws.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BL Search settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "config.js",
        "storage.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
